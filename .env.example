# Copy to .env and fill in. The app runs WITHOUT a key in demo mode, replaying a
# committed run of the Nordwind corpus, so you can see every screen before you
# decide to spend anything.

OPENAI_API_KEY=

# 'openai' (default) or 'anthropic'. Anthropic supports the chat roles only —
# audio and embeddings always route to OpenAI.
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=

# One env var per role. The cheap model does the volume work; only synthesis
# needs the strong one.
MODEL_ROUTER=gpt-4.1-mini
MODEL_EXTRACTOR=gpt-4.1-mini
MODEL_SYNTHESIZER=gpt-4.1
MODEL_CRITIC=gpt-4.1-mini
MODEL_VISION=gpt-4.1-mini
MODEL_POC=gpt-4.1
MODEL_AUDIO=whisper-1
MODEL_EMBED=text-embedding-3-small

# Max concurrent LLM calls when fanning out over sources.
CONCURRENCY=6

# Attempts per stage before the loop gives up and flags for human review.
MAX_ATTEMPTS=3

# SQLite file. Delete it to start clean, or run `npm run reset`.
PRISM_DB=./data/prism.db
